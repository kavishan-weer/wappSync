# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-side only, used by webhook)
SUPABASE_SERVICE_ROLE_KEY=

# Groq API key (server-side only, used for AI classification and response)
GROQ_API_KEY=

# Google Gemini API key (server-side only, used for embedding generation in RAG)
# Get it free from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# App URL (used to display webhook URL in dashboard)
NEXT_PUBLIC_APP_URL=http://localhost:3000
